# GEMINI_API_KEY: Optional Gemini AI API key if needed
GEMINI_API_KEY=""

# APP_URL: The public URL of the application (e.g. https://resimpaylas.up.railway.app)
APP_URL="http://localhost:3000"

# SERVER CONFIGURATION
PORT=3000
NODE_ENV="development"
JWT_SECRET="resimpaylas-secure-jwt-secret-replace-in-production-min-32-chars"

# DATABASE (PostgreSQL for Railway or local instance)
# Format: postgresql://username:password@host:port/database?sslmode=require
DATABASE_URL=""
# Or individual parameters:
PGHOST=""
PGPORT="5432"
PGUSER=""
PGPASSWORD=""
PGDATABASE=""

# BUNNY.NET STORAGE & CDN (Required for production image persistence)
# 1. Bunny.net Storage Zone Name
BUNNY_STORAGE_ZONE=""
# 2. Bunny.net Storage Zone Access Key / Password (NOT account API key)
BUNNY_STORAGE_PASSWORD=""
# 3. Storage Region: "de" (Falkenstein/EU - default), "ny" (New York), "la" (Los Angeles), "sg" (Singapore), "syd" (Sydney), "jh" (Johannesburg), "br" (Sao Paulo)
BUNNY_STORAGE_REGION="de"
# 4. Bunny.net CDN Pull Zone Base URL (e.g. https://resimpaylas.b-cdn.net or https://cdn.yourdomain.com)
BUNNY_CDN_BASE_URL=""
# 5. Optional Bunny.net Account API Key (for automated zone management)
BUNNY_API_KEY=""

